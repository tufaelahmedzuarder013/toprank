# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL 14+ connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toprung"
# Optional: direct (non-pooled) connection used only for migrations — e.g. Neon's unpooled URL on Vercel
DIRECT_URL=""
# Separate database used by `npm test` (its tables are truncated between tests!)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/toprung_test"

# ─── Site ────────────────────────────────────────────────────────────────────
# Public base URL, used for Stripe redirect URLs, canonical links, sitemap and OG tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Admin bootstrap (used by `npm run db:seed`) ─────────────────────────────
# Creates or promotes this account to ADMIN. Password must be at least 10 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-something-long"

# Set to "false" to seed without the fictional demo listings
SEED_DEMO="true"

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
# Leave both empty to run in DEMO mode (simulated checkout, clearly labelled, no money moves).
# Use TEST keys (sk_test_...) while developing; switch to live keys only when you go live.
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` or the Stripe Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=""

# ─── Cron ────────────────────────────────────────────────────────────────────
# Shared secret for GET /api/cron/daily-snapshot (send as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""
