// Toprung — pay-to-rank leaderboard
// Money is stored as whole US dollars (Int). Rankings are always derived from
// confirmed payments on the server.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ListingKind {
  WEBSITE
  X_PROFILE
}

enum ListingStatus {
  PENDING // reserved while a first checkout is in progress
  ACTIVE
  HIDDEN
  REMOVED
}

enum PaymentKind {
  NEW_LISTING
  UPGRADE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  EXPIRED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  DEMO
}

enum VerificationMethod {
  DNS
  META
  FILE
  MANUAL
  DEMO
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  passwordHash    String
  role            Role             @default(USER)
  createdAt       DateTime         @default(now())
  sessions        Session[]
  ownedListings   Listing[]        @relation("ListingOwner")
  createdListings Listing[]        @relation("ListingCreator")
  payments        Payment[]
  ownershipClaims OwnershipClaim[]
}

model Session {
  /// SHA-256 hash of the session token stored in the cookie
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  icon        String    @default("sparkles")
  description String    @default("")
  enabled     Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  listings    Listing[]
}

model Listing {
  id               String           @id @default(cuid())
  slug             String           @unique
  kind             ListingKind      @default(WEBSITE)
  /// Normalised identity used to prevent duplicate listings (e.g. "example.com", "x:handle")
  urlKey           String           @unique
  url              String
  domain           String
  name             String
  description      String           @default("")
  logoUrl          String?
  ogImageUrl       String?
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  status           ListingStatus    @default(PENDING)
  /// Cumulative confirmed payments in whole USD
  totalAmount      Int              @default(0)
  /// When the listing reached its current total — earlier wins ties
  rankedAt         DateTime?
  clicks           Int              @default(0)
  isDemo           Boolean          @default(false)
  createdById      String?
  createdBy        User?            @relation("ListingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  ownerId          String?
  owner            User?            @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  verifiedAt       DateTime?
  /// Payment currently holding the reservation of a PENDING listing
  pendingPaymentId String?          @unique
  reservedUntil    DateTime?
  /// First confirmed payment ("date added")
  confirmedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  payments         Payment[]
  ownershipClaims  OwnershipClaim[]

  @@index([status, totalAmount(sort: Desc), rankedAt])
  @@index([categoryId, status, totalAmount(sort: Desc)])
}

model Payment {
  id                String          @id @default(cuid())
  listingId         String
  listing           Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind              PaymentKind
  /// Amount charged in whole USD (for upgrades: only the difference)
  amount            Int
  previousTotal     Int
  targetTotal       Int
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider
  providerSessionId String?         @unique
  providerPaymentId String?
  estimatedRank     Int?
  finalRank         Int?
  failureReason     String?
  /// Snapshot of the submitted listing details (new listings), applied on confirmation
  claimDetails      Json?
  isDemo            Boolean         @default(false)
  confirmedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, confirmedAt])
  @@index([listingId, status])
}

/// Every processed provider event — guarantees a notification is applied once
model WebhookEvent {
  id         String          @id
  provider   PaymentProvider
  type       String
  receivedAt DateTime        @default(now())
}

model OwnershipClaim {
  id         String              @id @default(cuid())
  listingId  String
  listing    Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String              @unique
  method     VerificationMethod?
  verifiedAt DateTime?
  createdAt  DateTime            @default(now())

  @@unique([listingId, userId])
}

/// Frozen ranking of a past UTC day
model DailySnapshot {
  /// YYYY-MM-DD (UTC)
  date      String   @id
  entries   Json
  createdAt DateTime @default(now())
}

model SiteSettings {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model ContentPage {
  slug      String   @id
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
